# VCS / CI
.git
.github

# Secrets & local env (never bake into the image)
.env
*.env.local

# Python caches
__pycache__
*.pyc
*.pyo
.pytest_cache
.venv

# Frontend — not part of the backend image (also keeps node_modules out)
web

# The Chroma index is rebuilt at image-build time (see Dockerfile); never copy a
# local copy in. The raw filings under data/sec_filings/ ARE included so the
# build can re-index from them.
data/chroma_db

# Derived data the image rebuilds itself (ingestion/pipeline.py builds the
# fact table; the BM25 pickle is built lazily on first use of that mode).
data/facts.sqlite
data/bm25_index.pkl

# Logs & eval run artifacts (the committed evidence under eval/results/ is
# not needed at runtime either, but is small and harmless)
*.log
eval/results.json
eval/results/ci
eval/cache
