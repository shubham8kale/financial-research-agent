# .env.example
#
# Copy this file to `.env` and fill in real values before running the project.
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control — add it to .gitignore.
# This example file is safe to commit: it documents required variables without
# exposing any actual secrets.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your secret API key from https://platform.openai.com/api-keys
# Used for:
#   - Generating embeddings (text-embedding-3-small) during ingestion
#   - Driving the LLM (gpt-4o or similar) during the Q&A / research phase
#
# Billing note: embedding calls are cheap (~$0.02 / 1M tokens), but LLM
# completions can add up quickly. Monitor usage at platform.openai.com/usage.
OPENAI_API_KEY=sk-...your-key-here...
