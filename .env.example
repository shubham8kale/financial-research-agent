# .env.example
#
# Copy this file to `.env` and fill in real values before running the project.
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control — add it to .gitignore.
# This example file is safe to commit: it documents required variables without
# exposing any actual secrets.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your secret API key from https://platform.openai.com/api-keys
# Used for the LLM layer if you switch back from Gemini to GPT-4o.
# Embeddings now run locally (all-MiniLM-L6-v2) so this key is not required
# for the default configuration.
#
# Billing note: LLM completions can add up quickly.
# Monitor usage at platform.openai.com/usage.
OPENAI_API_KEY=sk-...your-key-here...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Your Gemini API key from https://aistudio.google.com/app/apikey
# Used by retrieval/query_engine.py and the agent to call Gemini 2.5 Flash-Lite
# for answer generation.  A free tier is available (per-minute RPM / TPM caps
# apply; the eval pipeline spaces calls by 5 s to stay well under them).
#
# The key is loaded via python-dotenv in query_engine.py — never hard-code it.
GEMINI_API_KEY=...your-key-here...

# ── Others ────────────────────────────────────────────────────────────────────
# Email address to use in the User-Agent header when the agent makes web requests.
SEC_USER_AGENT_EMAIL=...your-email-here...
# Model used for the agent's LLM calls.  Default is a Gemini flash-lite model.
LLM_MODEL=...your-choice-of-gemini-model-here...  # e.g. gemini-2.5-flash-lite
# Model used for the RAGAS judge.  Default is a Gemini flash-lite model.
RAGAS_LLM_MODEL=...your-choice-of-ragas-model-here...  # e.g. gemini-3.1-flash-lite-preview