# .env.example
#
# Copy this file to `.env` and fill in real values before running the project.
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control — add it to .gitignore.
# This example file is safe to commit: it documents required variables without
# exposing any actual secrets.

# ── OpenAI (NOT REQUIRED) ─────────────────────────────────────────────────────
# Nothing in this repository reads OPENAI_API_KEY. Embeddings run locally
# (all-MiniLM-L6-v2) and the LLM layer is Gemini. The variable is kept here only
# as a placeholder for anyone swapping the provider; leave it unset otherwise.
# OPENAI_API_KEY=sk-...your-key-here...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Your Gemini API key from https://aistudio.google.com/app/apikey
# Used by retrieval/query_engine.py, the agent and the output contract's
# structuring call to reach Gemini (the model is LLM_MODEL below).  A free tier is available (per-minute RPM / TPM caps
# apply; the eval pipeline spaces calls by 5 s to stay well under them).
#
# The key is loaded via python-dotenv in query_engine.py — never hard-code it.
GEMINI_API_KEY=...your-key-here...

# ── Others ────────────────────────────────────────────────────────────────────
# Email address for the User-Agent header when ingestion/downloader.py fetches
# filings from SEC EDGAR. Optional: the five filings are committed under data/.
SEC_USER_AGENT_EMAIL=...your-email-here...
# Model used for the agent's LLM calls.  Leave unset to take the shipped default,
# gemini-3.1-flash-lite — the model the reported results were measured on.  The
# earlier gemini-2.5-flash-lite returned an empty answer on 10 of 66 benchmark
# items (eval/EVALUATION.md finding 1); do not pick it to reproduce the numbers.
LLM_MODEL=...your-choice-of-gemini-model-here...  # e.g. gemini-3.1-flash-lite
# Model used for the RAGAS judge when --judge-provider is google (or omitted).
RAGAS_LLM_MODEL=...your-choice-of-ragas-model-here...  # e.g. gemini-3.6-flash

# ── Cross-family eval judge (used by --judge-provider groq) ───────────────────
# The cross-family check (eval/EVALUATION.md finding 4) judges with a DIFFERENT
# model family from the agent to look for same-model judge bias; the headline
# runs use the Gemini judge above.
#
# Get a free Groq key at https://console.groq.com/keys. Free-tier limits for
# openai/gpt-oss-120b are 30 RPM / 1,000 RPD / 8,000 TPM / 200,000 TPD, and the
# harness rate-limits itself to stay inside them.
#
# The key is read ONLY from the environment — never passed as a CLI flag, where
# it would land in shell history. The provider and model can also be given as
# --judge-provider / --judge-model on eval.run_eval.
RAGAS_JUDGE_PROVIDER=groq
RAGAS_JUDGE_MODEL=openai/gpt-oss-120b
RAGAS_JUDGE_API_KEY=gsk_...your-groq-key-here...

# ── Optional tuning knobs (all have working defaults) ─────────────────────────
# Seconds the API waits for an agent run before returning an error. Default 120.
# AGENT_TIMEOUT_SECONDS=120
# URL of the MCP server. The MCP-backed agent needs the /mcp path (its default
# is http://localhost:8000/mcp); the API's /health check uses host and port only.
# MCP_SERVER_URL=http://localhost:8000/mcp
# Judge requests/second cap in eval/run_eval.py. Overrides the per-provider
# default (google 0.2, groq 0.1). Lower this if you see sustained 429s.
# EVAL_JUDGE_RPS=0.1
# Per-job timeout for RAGAS scoring, in seconds. Default 900. Raise it if
# throttling causes TimeoutError NaNs; see eval/EVALUATION.md finding 8.
# EVAL_RAGAS_TIMEOUT=900

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API (used by the
# CORS middleware for /query, /query/stream, etc.).  Include the Next.js dev
# server and, once deployed, the Vercel domain.  Server-to-server callers are
# unaffected by CORS.  Default: http://localhost:3000,https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# ── Retrieval configuration (all optional; defaults = dense top-5, the code default) ──
# Every retrieval the agent's tools make goes through retrieval/retriever.py,
# which reads these at first use. Unset, it is dense top-5 search. The measured
# configuration (README, "Retrieval switches") is RETRIEVAL_RERANK=true,
# RETRIEVAL_FETCH_K=50, RETRIEVAL_TICKER_FILTER=inferred; every results file
# records which one it ran with. Measure a change with
# `python -m eval.run_retrieval_eval` (no LLM calls) before switching it on.
# RETRIEVAL_MODE=dense            # dense | bm25 | hybrid (RRF of both)
# RETRIEVAL_K=5                   # chunks returned per search call (TOP_K)
# RETRIEVAL_FETCH_K=25            # candidates per source before fusion / reranking
# RETRIEVAL_RRF_K=60              # Reciprocal Rank Fusion constant (hybrid)
# RETRIEVAL_DENSE_WEIGHT=1.0
# RETRIEVAL_SPARSE_WEIGHT=1.0
# RETRIEVAL_RERANK=false          # re-order FETCH_K candidates with a CPU cross-encoder
# RETRIEVAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_TICKER_FILTER=none    # none | inferred (restrict to the one company the query names)

# ── Output verification ──────────────────────────────────────────────────────
# Every answer is turned into a record of claims with the observation ids that
# support them, and checked against what the agent retrieved this turn — no
# model in the check (agent/contract.py).  strict (default): an answer that
# fails after one repair attempt is refused and the API says what it could not
# verify.  warn: the draft is served with the verdict attached.  off: no
# structuring call, no check — the behaviour before the contract existed.
# VERIFY_MODE=strict

# ── Index location (optional) ────────────────────────────────────────────────
# Where the Chroma index lives; the BM25 pickle and the XBRL fact table sit
# next to it. Default data/chroma_db. Point it elsewhere to keep a rebuild or
# the CI slice (`python -m eval.ci_corpus index`) apart from the shipped index.
# CHROMA_PERSIST_DIR=data/chroma_db

# ── Tracing (optional) ───────────────────────────────────────────────────────
# LangSmith traces every agent run with no code change once these are set.
# The API's `meta.trace_id` (and the SSE `meta` event) is the run id to open.
# Tests force tracing off; the API and the eval harness trace whenever these
# are set. A Personal Access Token from the LangSmith Settings
# page works; keep it out of GitHub. Free tier: about 5,000 traces a month.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...your-key-here...
# LANGSMITH_PROJECT=financial-research-agent
