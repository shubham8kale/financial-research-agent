# .env.example
#
# Copy this file to `.env` and fill in real values before running the project.
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control — add it to .gitignore.
# This example file is safe to commit: it documents required variables without
# exposing any actual secrets.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your secret API key from https://platform.openai.com/api-keys
# Used for the LLM layer if you switch back from Gemini to GPT-4o.
# Embeddings now run locally (all-MiniLM-L6-v2) so this key is not required
# for the default configuration.
#
# Billing note: LLM completions can add up quickly.
# Monitor usage at platform.openai.com/usage.
OPENAI_API_KEY=sk-...your-key-here...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Your Gemini API key from https://aistudio.google.com/app/apikey
# Used by retrieval/query_engine.py to call Gemini 1.5 Flash for answer
# generation.  A free tier is available (15 requests/min, 1M tokens/min).
#
# The key is loaded via python-dotenv in query_engine.py — never hard-code it.
GEMINI_API_KEY=...your-key-here...
