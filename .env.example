# .env.example
#
# Copy this file to `.env` and fill in real values before running the project.
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control — add it to .gitignore.
# This example file is safe to commit: it documents required variables without
# exposing any actual secrets.

# ── OpenAI (NOT REQUIRED) ─────────────────────────────────────────────────────
# Nothing in this repository reads OPENAI_API_KEY. Embeddings run locally
# (all-MiniLM-L6-v2) and the LLM layer is Gemini. The variable is kept here only
# as a placeholder for anyone swapping the provider; leave it unset otherwise.
# OPENAI_API_KEY=sk-...your-key-here...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Your Gemini API key from https://aistudio.google.com/app/apikey
# Used by retrieval/query_engine.py and the agent to call Gemini 2.5 Flash-Lite
# for answer generation.  A free tier is available (per-minute RPM / TPM caps
# apply; the eval pipeline spaces calls by 5 s to stay well under them).
#
# The key is loaded via python-dotenv in query_engine.py — never hard-code it.
GEMINI_API_KEY=...your-key-here...

# ── Others ────────────────────────────────────────────────────────────────────
# Email address to use in the User-Agent header when the agent makes web requests.
SEC_USER_AGENT_EMAIL=...your-email-here...
# Model used for the agent's LLM calls.  Leave unset to take the shipped default,
# gemini-3.1-flash-lite — the model the reported results were measured on.  The
# earlier gemini-2.5-flash-lite returned an empty answer on 10 of 66 benchmark
# items (eval/EVALUATION.md finding 1); do not pick it to reproduce the numbers.
LLM_MODEL=...your-choice-of-gemini-model-here...  # e.g. gemini-3.1-flash-lite
# Model used for the RAGAS judge when --judge-provider is google (or omitted).
RAGAS_LLM_MODEL=...your-choice-of-ragas-model-here...  # e.g. gemini-3.6-flash

# ── Cross-family eval judge (used by --judge-provider groq) ───────────────────
# The reported evaluation judges with a DIFFERENT model family from the agent,
# for two reasons: it removes same-model judge bias, and Gemini's free tier
# allows only 20 requests/day/model, which cannot absorb a judge pass.
#
# Get a free Groq key at https://console.groq.com/keys. Free-tier limits for
# openai/gpt-oss-120b are 30 RPM / 1,000 RPD / 8,000 TPM / 200,000 TPD, and the
# harness rate-limits itself to stay inside them.
#
# These three are read ONLY from the environment — never passed as CLI flags,
# where they would land in shell history.
RAGAS_JUDGE_PROVIDER=groq
RAGAS_JUDGE_MODEL=openai/gpt-oss-120b
RAGAS_JUDGE_API_KEY=gsk_...your-groq-key-here...

# ── Optional tuning knobs (all have working defaults) ─────────────────────────
# Seconds the API waits for an agent run before returning an error. Default 120.
# AGENT_TIMEOUT_SECONDS=120
# Base URL of the MCP server, used by the MCP-backed agent. Default localhost:8000.
# MCP_SERVER_URL=http://localhost:8000
# Judge requests/second cap in eval/run_eval.py. Overrides the per-provider
# default (google 0.2, groq 0.1). Lower this if you see sustained 429s.
# EVAL_JUDGE_RPS=0.1
# Per-job timeout for RAGAS scoring, in seconds. Default 900. Raise it if
# throttling causes TimeoutError NaNs; see eval/EVALUATION.md finding 2.
# EVAL_RAGAS_TIMEOUT=900

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API (used by the
# CORS middleware for /query, /query/stream, etc.).  Include the Next.js dev
# server and, once deployed, the Vercel domain.  Server-to-server callers are
# unaffected by CORS.  Default: http://localhost:3000,https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# ── Retrieval configuration (all optional; defaults = the shipped behaviour) ──
# Every retrieval the agent's tools make goes through retrieval/retriever.py,
# which reads these at first use. Leave them unset for dense top-5 search,
# which is what every reported number was measured on unless its results file
# says otherwise. Measure a change with `python -m eval.run_retrieval_eval`
# (no LLM calls) before switching it on; see eval/EVALUATION.md.
# RETRIEVAL_MODE=dense            # dense | bm25 | hybrid (RRF of both)
# RETRIEVAL_FETCH_K=25            # candidates per source before fusion / reranking
# RETRIEVAL_RRF_K=60              # Reciprocal Rank Fusion constant (hybrid)
# RETRIEVAL_DENSE_WEIGHT=1.0
# RETRIEVAL_SPARSE_WEIGHT=1.0
# RETRIEVAL_RERANK=false          # re-order FETCH_K candidates with a CPU cross-encoder
# RETRIEVAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_TICKER_FILTER=none    # none | inferred (restrict to the one company the query names)
